{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "functionFailoverRegions": ["sfo1"],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] && [ \"$(git rev-list --parents -n 1 HEAD | awk '{print NF}')\" -lt 3 ]; then echo 'Ignoring direct non-merge push to main'; exit 0; fi; exit 1",
  "git": {
    "deploymentEnabled": {
      "source-only-hardening": false,
      "source-only-driver-training-robustness": false,
      "source-only-driver-assessment-template": false,
      "source-only-driver-assessment-governance": false,
      "source-only-driver-training-formal-ui": false,
      "pre-vercel-upgrade-batch-2026-09-14": false
    }
  }
}
