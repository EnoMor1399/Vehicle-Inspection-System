# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production VIMS must target the dedicated application database, not Neon's default `neondb`.
EXPECTED_DATABASE_NAME=Vehicle-Inspection-Enterprise
# Vercel/serverless routes Neon connections through the transaction pooler by default.
DB_USE_NEON_POOLER=true
# Keep serverless pools deliberately small; each warm function instance may own a pool.
DATABASE_POOL_SIZE=5
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=35000
HEALTH_DB_DEGRADED_MS=750

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Release version is source-controlled from package.json; APP_VERSION is not required.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Authentication & cryptography (use unique random values, 32+ characters)
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
API_KEY_SALT=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-with-a-unique-32-plus-character-secret
CERTIFICATE_SIGNING_SECRET=replace-with-a-separate-32-plus-character-secret

# Session and account policy
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_BCRYPT_ROUNDS=12
# Privileged staff are redirected to enrollment until TOTP is enabled.
# Set to "off" only as a documented emergency break-glass action.
PRIVILEGED_2FA_ENFORCEMENT=on
REQUIRE_PRIVILEGED_2FA=true
# Production self-registration is disabled unless this is explicitly true.
ALLOW_PUBLIC_SIGNUP=false

# Distributed rate limiting (required for Vercel/serverless production)
REQUIRE_DISTRIBUTED_RATE_LIMIT=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MEMORY_MAX_ENTRIES=5000

# API / allowed application origins (comma separated when multiple)
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# 2FA
TWO_FACTOR_ISSUER=Vehicle Inspection Management System

# Optional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional monitoring
SENTRY_DSN=
ERROR_TRACKING_WEBHOOK=
LOG_LEVEL=info
LOG_FORMAT=json
