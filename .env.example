# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_POOL_SIZE=20

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
APP_VERSION=2.0.0
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Authentication & cryptography (use unique random values, 32+ characters)
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
API_KEY_SALT=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-with-a-unique-32-plus-character-secret
CERTIFICATE_SIGNING_SECRET=replace-with-a-separate-32-plus-character-secret

# Session and account policy
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_BCRYPT_ROUNDS=12
REQUIRE_PRIVILEGED_2FA=false

# Distributed rate limiting (recommended for Vercel/serverless production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# API / allowed application origins (comma separated when multiple)
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# 2FA
TWO_FACTOR_ISSUER=Vehicle Inspection Management System

# Optional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional monitoring
SENTRY_DSN=
ERROR_TRACKING_WEBHOOK=
LOG_LEVEL=info
LOG_FORMAT=json
